      "css": ".ds-funn{display:flex;align-items:center;gap:12px;padding:11px 18px;background:var(--kort,#fff);font-family:var(--sans)}.ds-funn__tall{font-family:var(--mono);font-size:15px;font-weight:600;font-variant-numeric:tabular-nums;color:var(--blekk,#17181A)}.ds-maaler{position:relative;width:72px;height:6px;border-radius:3px;background:var(--innfelt-2,#E6E3DA);overflow:hidden}.ds-maaler i{position:absolute;inset:0 auto 0 0;border-radius:3px;background:var(--treff-3,#00778C)}.ds-funn__stilling{font-size:14.5px;font-weight:600;letter-spacing:-.01em}"
