      "css": ".ds-topp{display:flex;gap:30px;align-items:flex-start;padding:26px 26px 24px 28px;border-radius:var(--r,14px);background:var(--treff-vask,#EAF8FB);box-shadow:var(--loft,0 1px 2px rgba(24,26,30,.05),0 4px 14px rgba(24,26,30,.07));font-family:var(--sans)}.ds-topp__stor{margin:0;font-family:var(--mono);font-size:80px;font-weight:600;letter-spacing:-.04em;line-height:.84;font-variant-numeric:tabular-nums;color:var(--treff-4,#005266)}.ds-topp__stor span{margin-left:4px;font-size:22px;font-weight:500;letter-spacing:0}.ds-topp__stilling{margin:0;font-size:21px;font-weight:700;letter-spacing:-.024em;color:var(--blekk,#17181A)}.ds-topp__hvem{margin:6px 0 0;font-size:14px;color:var(--blekk-2,#4A4E54)}"
    }
