{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jobbsøknader",
  "version": "1.0.0",
  "identifier": "no.nordli.jobbsoknader",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run bygg:front",
    "beforeBuildCommand": "npm run bygg:front"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Jobbsøknader",
        "width": 1180,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "copyright": "Martin Nordli",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
