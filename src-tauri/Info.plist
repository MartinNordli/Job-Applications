<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Appen starter som UIElement, så bakgrunnskjøringen av Radar (--radar)
     aldri står som en vanlig app i Dock, ikke engang et øyeblikk. En vanlig
     oppstart gjør seg selv til Regular i setup, før hovedvinduet lages. -->
<plist version="1.0">
<dict>
  <key>LSUIElement</key>
  <true/>
</dict>
</plist>
